---
/**
 * Optional depth for readers who want the maths. Collapsed by default.
 *
 *   <Deeper title="Why 2ⁿ vertices?"> … $V = 2^n$ … </Deeper>
 */
import { t } from '../../i18n/ui';
import { DEFAULT_LOCALE, isLocale } from '../../i18n/locales';

interface Props {
  title?: string;
}
const locale = isLocale(Astro.currentLocale) ? Astro.currentLocale : DEFAULT_LOCALE;
const { title } = Astro.props;
---

<details class="deeper">
  <summary><span class="deeper__label">{t(locale, 'deeper')}</span>{title && <span class="deeper__title">{title}</span>}</summary>
  <div class="deeper__body"><slot /></div>
</details>

<style is:global>
  .deeper {
    margin: var(--space-3) 0;
    padding: 0.75em 1.1em;
    border-radius: var(--radius-card);
    background: color-mix(in oklab, var(--axis-2) 7%, var(--paper));
    font-size: 0.94em;
  }
  .deeper summary {
    cursor: pointer;
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0 0.6em;
    color: var(--axis-2-text);
  }
  .deeper summary::-webkit-details-marker {
    display: none;
  }
  .deeper summary::before {
    content: '+';
    width: 1em;
    display: inline-block;
    transition: transform 200ms var(--ease);
  }
  .deeper[open] summary::before {
    transform: rotate(45deg);
  }
  .deeper__label {
    font-style: italic;
  }
  :lang(zh) .deeper__label {
    font-style: normal;
  }
  .deeper__title {
    color: var(--ink);
  }
  .deeper__body {
    padding-top: var(--space-2);
  }
</style>
