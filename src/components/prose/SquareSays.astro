---
/**
 * A Square, our narrator from Flatland, speaking in the margin. Use sparingly:
 * one or two per chapter, for his reaction, not for exposition.
 */
---

<aside class="square-says">
  <svg class="square-says__glyph" viewBox="0 0 20 20" aria-hidden="true"><rect x="3" y="3" width="14" height="14" /></svg>
  <div class="square-says__body"><slot /></div>
</aside>

<style is:global>
  .square-says {
    display: grid;
    grid-template-columns: 1.4em 1fr;
    gap: var(--space-2);
    margin: var(--space-3) 0;
    font-style: italic;
    color: var(--ink-soft);
  }
  :lang(zh) .square-says {
    font-style: normal;
    font-family: var(--font-cjk);
  }
  .square-says__glyph {
    width: 1.1em;
    height: 1.1em;
    margin-top: 0.3em;
    fill: none;
    stroke: var(--ink);
    stroke-width: 1.5;
  }
  .square-says__body > :last-child {
    margin-bottom: 0;
  }
</style>
