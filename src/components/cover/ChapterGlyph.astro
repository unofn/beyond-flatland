---
/**
 * A small ink glyph for each chapter's idea, keyed by chapter slug. Unknown
 * slugs get A Square. Colour follows the book's rules: axis colours only
 * where the stroke really runs along that axis (extrusion into z is blue,
 * the tesseract's w edges are violet); Byrne fills otherwise.
 */
interface Props {
  slug: string;
}
const { slug } = Astro.props;

// Petrie polygon of the 5-cube: a decagon whose vertices are joined to their
// third neighbours.
const decagon = Array.from({ length: 10 }, (_, i) => {
  const a = -Math.PI / 2 + (i / 10) * Math.PI * 2;
  return [24 + 18 * Math.cos(a), 24 + 18 * Math.sin(a)] as const;
});
const f = (n: number) => Math.round(n * 100) / 100;
const decagonPath = decagon.map(([x, y], i) => `${i ? 'L' : 'M'}${f(x)} ${f(y)}`).join(' ') + ' Z';
const decagonChords = decagon
  .map(([x, y], i) => {
    const [u, v] = decagon[(i + 3) % 10]!;
    return `M${f(x)} ${f(y)} L${f(u)} ${f(v)}`;
  })
  .join(' ');

// Data: points scattered about a line, each dropped onto it.
const dataPts: [number, number][] = [
  [8, 30], [15, 36], [19, 22], [27, 30], [31, 14], [39, 21],
];
const L0 = [4, 38] as const;
const L1 = [44, 10] as const;
const dataProj = dataPts.map(([x, y]) => {
  const dx = L1[0] - L0[0];
  const dy = L1[1] - L0[1];
  const t = ((x - L0[0]) * dx + (y - L0[1]) * dy) / (dx * dx + dy * dy);
  return [f(L0[0] + t * dx), f(L0[1] + t * dy)] as const;
});
---

<svg class="glyph" viewBox="0 0 48 48" aria-hidden="true" focusable="false">
  {
    slug === 'extrusion' && (
      <>
        <rect x="18" y="8" width="22" height="22" class="g-faint" />
        <path d="M8 18 L18 8 M30 18 L40 8 M30 40 L40 30 M8 40 L18 30" class="g-z" />
        <rect x="8" y="18" width="22" height="22" />
      </>
    )
  }
  {
    slug === 'flatland' && (
      <>
        <circle cx="24" cy="21" r="13" />
        <path d="M3 29 H45" class="g-faint" />
        <path d="M13.3 29 H34.7" class="g-accent" />
      </>
    )
  }
  {
    slug === 'slicing' && (
      <>
        <path d="M18 6 H40 V28 M18 6 V28 H40" class="g-faint" />
        <path d="M19 38 L8 27 L13 11 L29 6 L40 17 L35 33 Z" class="g-section" />
        <path d="M8 16 L18 6 M30 16 L40 6 M30 38 L40 28 M8 38 L18 28" />
        <rect x="8" y="16" width="22" height="22" />
      </>
    )
  }
  {
    slug === 'shadows' && (
      <>
        <path d="M13 45 L19 40 L37 40 L31 45 Z" class="g-shadow" />
        <path d="M13 23 V45 M31 23 V45 M37 18 V40" class="g-faint g-dash" />
        <rect x="13" y="5" width="18" height="18" />
        <path d="M13 5 L19 0 H37 V18 L31 23 M31 5 L37 0" />
      </>
    )
  }
  {
    slug === 'unfolding' && (
      <>
        <rect x="19.5" y="15" width="9" height="9" class="g-face" />
        <path d="M19.5 6 H28.5 V42 H19.5 Z M19.5 15 H28.5 M19.5 24 H28.5 M19.5 33 H28.5 M10.5 15 H37.5 V24 H10.5 Z" />
      </>
    )
  }
  {
    slug === 'beyond-four' && (
      <>
        <path d={decagonChords} class="g-faint" />
        <path d={decagonPath} />
        {decagon.map(([x, y]) => <circle cx={f(x)} cy={f(y)} r="1.4" class="g-dot" />)}
      </>
    )
  }
  {
    slug === 'data' && (
      <>
        <path d={`M${L0[0]} ${L0[1]} L${L1[0]} ${L1[1]}`} />
        <path d={dataPts.map(([x, y], i) => `M${x} ${y} L${dataProj[i]![0]} ${dataProj[i]![1]}`).join(' ')} class="g-faint" />
        {dataPts.map(([x, y]) => <circle cx={x} cy={y} r="1.5" class="g-dot" />)}
        {dataProj.map(([x, y]) => <circle cx={x} cy={y} r="1.5" class="g-dot g-dot-accent" />)}
      </>
    )
  }
  {
    slug === 'lab' && (
      <>
        <path d="M6 6 L16 16 M42 6 L32 16 M42 42 L32 32 M6 42 L16 32" class="g-w" />
        <rect x="6" y="6" width="36" height="36" />
        <rect x="16" y="16" width="16" height="16" />
      </>
    )
  }
  {
    !['extrusion', 'flatland', 'slicing', 'shadows', 'unfolding', 'beyond-four', 'data', 'lab'].includes(slug) && (
      <rect x="14" y="14" width="20" height="20" class="g-accent" />
    )
  }
</svg>

<style>
  .glyph {
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
    fill: none;
    stroke: var(--ink);
    stroke-width: 1.3;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .g-faint {
    stroke: var(--ink-faint);
    stroke-width: 1;
  }
  .g-dash {
    stroke-dasharray: 1.5 2.5;
  }
  .g-accent {
    stroke: var(--accent);
    stroke-width: 2;
  }
  .g-z {
    stroke: var(--axis-2);
  }
  .g-w {
    stroke: var(--axis-3);
  }
  .g-section {
    fill: var(--fill-1);
    stroke-width: 1;
  }
  .g-shadow {
    fill: var(--fill-2);
    stroke: none;
  }
  .g-face {
    fill: var(--fill-0);
    stroke: none;
  }
  .g-dot {
    fill: var(--ink);
    stroke: none;
  }
  .g-dot-accent {
    fill: var(--accent);
  }
</style>
