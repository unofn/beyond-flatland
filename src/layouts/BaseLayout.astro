---
import '../styles/global.css';
import { LOCALES, LOCALE_TAGS, type Locale } from '../i18n/locales';
import { switchLocalePath, paths } from '../i18n/paths';
import { t } from '../i18n/ui';
import LanguageSwitch from '../components/site/LanguageSwitch.astro';

interface Props {
  locale: Locale;
  title: string;
  description: string;
  /** Hide the running header (the cover draws its own). */
  bare?: boolean;
}
const { locale, title, description, bare = false } = Astro.props;
const siteTitle = t(locale, 'siteTitle');
const fullTitle = title === siteTitle ? title : `${title} | ${siteTitle}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang={LOCALE_TAGS[locale]}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {
      LOCALES.map((l) => (
        <link rel="alternate" hreflang={LOCALE_TAGS[l]} href={new URL(switchLocalePath(Astro.url.pathname, l), Astro.site)} />
      ))
    }
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="article" />
    <meta name="theme-color" content="#efeee7" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#16171b" media="(prefers-color-scheme: dark)" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main">{t(locale, 'skipToContent')}</a>
    {
      !bare && (
        <header class="running-head">
          <a class="running-head__title" href={paths.home(locale)}>
            {siteTitle}
          </a>
          <LanguageSwitch locale={locale} />
        </header>
      )
    }
    <main id="main">
      <slot />
    </main>
  </body>
</html>

<style>
  .running-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--space-3);
    padding: var(--space-2) var(--gutter);
    padding-top: max(var(--space-2), env(safe-area-inset-top));
    font-size: var(--step--1);
    border-bottom: var(--rule);
  }
  .running-head__title {
    text-decoration: none;
    font-style: italic;
  }
  :global(:lang(zh)) .running-head__title {
    font-style: normal;
  }
</style>
